   "attributes": {
    "Science": "Still in use today. It showed the Moon is drifting away from Earth by about 3.8 centimetres a year \u2014 the only Apollo experiment still returning data.",
    "Title": "Laser Ranging Retroreflector (LRRR)",
    "What": "An array of corner-cube prisms. Any light hitting a corner cube bounces straight back the way it came.",
    "Why": "So observatories on Earth could fire a laser at the Moon and time how long the light takes to come back.",
    "ArtifactId": "retro",
    "Year": "Deployed 21 July 1969"
   },
